@using Downpatch.Web.Components.Guide.Models

<div class="level-card" aria-labelledby="level-info-title">
    <header class="level-header">
        <div>
            @if (!string.IsNullOrWhiteSpace(Info.Game))
            {
                <p class="level-game">@Info.Game</p>
            }

            <h2 id="level-info-title" class="level-title">@Info.Title details</h2>
        </div>

        @if (!string.IsNullOrWhiteSpace(Info.MissionNumber))
        {
            <p class="level-mission-number">@Info.MissionNumber</p>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(Info.HeroImage))
    {
        <img class="level-image"
             src="@Info.HeroImage"
             alt="" />
    }

    @if (!string.IsNullOrWhiteSpace(Info.MapName))
    {
        <section class="level-section" aria-labelledby="level-map-title">
            <h3 id="level-map-title" class="section-title">Map</h3>
            <code class="level-map-id">@Info.MapName</code>
        </section>
    }

    @if (Info.Goals.Any())
    {
        <section class="level-section" aria-labelledby="level-goals-title">
            <h3 id="level-goals-title" class="section-title">Goals</h3>

            <div class="difficulty-toggle" role="group" aria-label="Select goal difficulty">
                <button type="button"
                        aria-pressed="@(difficulty == "Easy" ? "true" : "false")"
                        @onclick="ShowEasy">
                    Easy
                </button>

                <button type="button"
                        aria-pressed="@(difficulty == "Legendary" ? "true" : "false")"
                        @onclick="ShowLegendary">
                    Legendary
                </button>

                <button type="button"
                        aria-pressed="@(difficulty == "LASO" ? "true" : "false")"
                        @onclick="ShowLASO">
                    LASO
                </button>
            </div>

            <dl class="goal-list" aria-live="polite">
                @foreach (var goal in Info.Goals)
                {
                    var selectedTime = GetGoalTime(goal);

                    <div class="goal-row">
                        <dt>@goal.Label</dt>
                        <dd>
                            @if (string.IsNullOrWhiteSpace(selectedTime))
                            {
                                <span aria-hidden="true">—</span>
                                <span class="visually-hidden">Not available</span>
                            }
                            else
                            {
                                @selectedTime
                            }
                        </dd>
                    </div>
                }
            </dl>
        </section>
    }

    <section class="level-section" aria-labelledby="level-navigation-title">
        <h3 id="level-navigation-title" class="section-title">Level navigation</h3>

        <nav class="level-navigation" aria-labelledby="level-navigation-title">
            @if (!string.IsNullOrWhiteSpace(Info.PreviousName))
            {
                <a class="level-nav-link" href="@Info.PreviousUrl">
                    <span aria-hidden="true">←</span> Previous: @Info.PreviousName
                </a>
            }

            <span class="nav-current" aria-current="page">Current: @Info.Title</span>

            @if (!string.IsNullOrWhiteSpace(Info.NextName))
            {
                <a class="level-nav-link" href="@Info.NextUrl">
                    Next: @Info.NextName <span aria-hidden="true">→</span>
                </a>
            }
        </nav>
    </section>
</div>

@code {
    [Parameter]
    public required LevelInfo Info { get; set; }

    private string difficulty = "Easy";

    private void ShowEasy() => difficulty = "Easy";
    private void ShowLegendary() => difficulty = "Legendary";
    private void ShowLASO() => difficulty = "LASO";

    private string? GetGoalTime(GoalInfo goal) => difficulty switch
    {
        "Legendary" => goal.Legendary,
        "LASO" => goal.Laso,
        _ => goal.Easy
    };
}
