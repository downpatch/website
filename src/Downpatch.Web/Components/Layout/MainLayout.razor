@inherits LayoutComponentBase

@inject NavigationManager Navigation

<a class="skip-link" href="@MainSkipHref">Skip to main content</a>

<header class="site-header">
    <div class="site-header-inner">
        <div class="site-brand">
            <a href="/" class="site-brand-link" aria-label="Downpatch home">
                <span class="site-brand-text">DOWNPATCH</span>
            </a>
        </div>
        <nav class="site-header-nav" aria-label="Primary">
            <a href="/guide" class="site-header-link">Guides</a>
            <a href="https://github.com/downpatch/content" class="site-header-link">Contribute</a>
        </nav>
    </div>
</header>

<main id="main" class="site-main" tabindex="-1">
    @Body
</main>

<footer class="site-footer">
    <nav class="site-footer-nav" aria-label="External links">
        <a class="site-footer-link" href="https://discord.gg/uvGWPTXx84" target="_blank" rel="noopener noreferrer">
            Discord
            <span class="visually-hidden"> (opens in a new tab)</span>
        </a>

        <a class="site-footer-link" href="https://github.com/downpatch" target="_blank" rel="noopener noreferrer">
            GitHub
            <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
    </nav>
</footer>

@code {
    private string MainSkipHref => Navigation.Uri.Split('#')[0] + "#main";
}
